generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COLLEGE_ADMIN
  ORGANIZER
  VOLUNTEER
  JUDGE
  STUDENT
}

enum Visibility {
  PRIVATE
  COLLEGE
  SELECTED_COLLEGES
  PUBLIC
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(STUDENT)
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventsOrganized Event[] @relation("EventOrganizer")
  teamMemberships TeamMember[]
  registrations   Registration[]
  attendances     Attendance[]
  notifications   Notification[]
  scoresGiven     Score[]
  certificates    Certificate[]
  feedbacks       Feedback[]
}

model College {
  id          String       @id @default(uuid())
  name        String       @unique
  domain      String       @unique
  isVerified  Boolean      @default(false)
  users       User[]
  departments Department[]
  venues      Venue[]
  events      Event[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  name      String
  collegeId String
  college   College  @relation(fields: [collegeId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, collegeId])
}

model Venue {
  id          String   @id @default(uuid())
  name        String
  capacity    Int
  latitude    Float?   // Added for Campus Navigation
  longitude   Float?   // Added for Campus Navigation
  collegeId   String
  college     College  @relation(fields: [collegeId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, collegeId])
}

model EventCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  events      Event[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Event {
  id             String        @id @default(uuid())
  title          String
  description    String
  startDate      DateTime
  endDate        DateTime
  registrationEnd DateTime
  maxParticipants Int
  teamSizeMin    Int           @default(1)
  teamSizeMax    Int           @default(1)
  rules          String?
  prizePool      String?
  visibility     Visibility    @default(COLLEGE)
  status         EventStatus   @default(PENDING)

  categoryId     String
  category       EventCategory @relation(fields: [categoryId], references: [id])

  organizerId    String
  organizer      User          @relation("EventOrganizer", fields: [organizerId], references: [id])

  collegeId      String
  college        College       @relation(fields: [collegeId], references: [id])

  registrations  Registration[]
  teams          Team[]
  attendances    Attendance[]
  scores         Score[]
  certificates   Certificate[]
  feedbacks      Feedback[]

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Team {
  id         String       @id @default(uuid())
  name       String
  eventId    String
  event      Event        @relation(fields: [eventId], references: [id])
  members    TeamMember[]
  registration Registration?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([name, eventId])
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  isLeader  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
}

model Registration {
  id        String    @id @default(uuid())
  ticketId  String    @unique @default(uuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id])
  userId    String?   // For individual registration
  user      User?     @relation(fields: [userId], references: [id])
  teamId    String?   @unique // For team registration
  team      Team?     @relation(fields: [teamId], references: [id])
  status    RegStatus @default(CONFIRMED)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Attendance {
  id            String   @id @default(uuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  checkInTime   DateTime @default(now())
  checkOutTime  DateTime?
  scannedBy     String?  // ID of volunteer who scanned

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([eventId, userId]) // Prevent duplicate scans
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Score {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  judgeId   String
  judge     User     @relation(fields: [judgeId], references: [id])

  participantId String? // userId if individual, teamId if team

  score     Float
  feedback  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, judgeId, participantId])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id])
  type      String   // PARTICIPATION, WINNER, VOLUNTEER, JUDGE
  issueDate DateTime @default(now())
  url       String?  // Link to PDF/Image stored in Cloudinary
  hash      String   @unique // Cryptographic hash for verification

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feedback {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  rating    Int      // 1 to 5
  comment   String
  sentiment String?  // POSITIVE, NEUTRAL, NEGATIVE (Generated by AI Mock)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}
